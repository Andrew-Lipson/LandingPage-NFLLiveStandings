---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  lightSrc: ImageMetadata;
  darkSrc: ImageMetadata;
  alt: string;
  sizes: string;
  eager?: boolean;
}

const { lightSrc, darkSrc, alt, sizes, eager = false } = Astro.props;
const [light, dark] = await Promise.all(
  [lightSrc, darkSrc].map((src) =>
    getImage({
      src,
      widths: [...[320, 480, 768, 1024].filter((width) => width < src.width), src.width],
      format: 'webp',
      quality: 85,
    })
  )
);
---

<picture class="theme-screenshot">
  <source
    data-theme-dark
    media="(prefers-color-scheme: dark)"
    srcset={dark.srcSet.attribute}
    {sizes}
    type="image/webp"
  />
  <img
    src={light.src}
    srcset={light.srcSet.attribute}
    {sizes}
    {alt}
    width={lightSrc.width}
    height={lightSrc.height}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : 'auto'}
    decoding="async"
  />
</picture>

<script>
  const syncScreenshots = () => {
    const isDark = document.documentElement.classList.contains('dark');
    document.querySelectorAll<HTMLSourceElement>('[data-theme-dark]').forEach((source) => {
      source.media = isDark ? 'all' : 'not all';
    });
  };

  syncScreenshots();
  new MutationObserver(syncScreenshots).observe(document.documentElement, {
    attributes: true,
    attributeFilter: ['class'],
  });
  document.addEventListener('astro:page-load', syncScreenshots);
</script>
