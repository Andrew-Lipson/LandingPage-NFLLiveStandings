---
import Features3 from '~/components/widgets/Features3.astro';
import Hero from '~/components/widgets/Hero.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'NFL Live Standings',
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    title="NFL LIVE STANDINGS"
    subtitle="NFL Live Standings is the first website that provides NFL standings in <strong>real-time</strong>.<br>See the standings as if all matches in progress finish with the current scores.<br>Supports all AFC and NFC division and conference standings along with the first round draft order."
    actions={[
      { variant: 'primary', text: 'Enter', href: 'https://standings.nfllivestandings.com', icon: 'tabler:square-rounded-arrow-right' },
    ]}
    image={{
      src: '~/assets/images/Conference.png',
      alt: 'Magnet attracting screws. Lead generation landing page demo',
    }}
  />

  <!-- Features3 Widget ************** -->

  <Features3
    title="Our Standings"
    subtitle="There are 3 different live standings to view, all being calculated by following the official tiebreaker procedures found here:<br> <a style='text-decoration: underline;' href='https://www.nfl.com/standings/tie-breaking-procedures' target='_blank'>https://www.nfl.com/standings/tie-breaking-procedures</a>"
    columns={3}
    isBeforeContent={true}
    isAfterContent={true}
    items={[
      {
        title: 'Division',
        description:
          'We show all 8 division and indicate which team is leading. Showing only the main statistics that matter for the division race',
        icon: 'tabler:template',
      },
      {
        title: 'Conference',
        description:
          'We show both the AFC and NFC standings and which teams are currently in a playoff position. We only show the statistics that matter for the conference standings (No Division record is used)',
        icon: 'tabler:template',
      },
      {
        title: 'Draft Order',
        description:
          "We show the live draft order, calculated with either the 'Current SOS' from teams they have already played, or 'Season SOS' using all 17 scheduled games. Updates throughout the playoffs and displays first round trades",
        icon: 'tabler:template',
      },
    ]}
  />

    <Features3
    columns={3}
    isBeforeContent={true}
    isAfterContent={true}
    items={[]}
    image={{ src: '~/assets/images/DraftOrder.png', alt: 'AstroWind Hero Image' }}
  />


  <!-- Steps2 Widget ****************** -->

  <Steps2
    title="Features"
    subtitle="We are continually trying to upgrade our website and implement new features that will benefit the end user. Earlier this year we added SOS Season as a toggle in settings, so to calculate the Draft Order, Conference and Division standings with both the teams current SOS or their 17 game season SOS. We also have many other features in the pipeline coming soon"
    items={[
      {
        title: 'Toggle between live and current standings',
      },
      {
        title: 'Toggle between SOS current and SOS season',
      },
      {
        title: 'Show first round draft pick trades',
      },
    ]}
  />

    <Hero2
    title="NFL LIVE STANDINGS"
    subtitle="Be the first one to know the standings before the game ends by visiting NFL LIVE STANDINGS now!"
    actions={[
      { variant: 'primary', text: 'Enter', href: 'https://standings.nfllivestandings.com', icon: 'tabler:square-rounded-arrow-right' },
    ]}
    image={{
      src: '~/assets/images/Division.png',
      alt: 'Store with a Coming Soon sign. Pre-launch Landing Page',
    }}
  />
</Layout>
