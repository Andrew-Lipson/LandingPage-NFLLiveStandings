---
import BrandMark from '~/components/BrandMark.astro';
import ThemeScreenshot from '~/components/ThemeScreenshot.astro';
import StandingsPreview from '~/components/StandingsPreview.astro';
import Layout from '~/layouts/Layout.astro';
import { landing } from '~/data/landing';
import divisionLight from '../../public/screenshots/division-desktop-light.png';
import divisionDark from '../../public/screenshots/division-desktop-dark.png';
import conferenceLight from '../../public/screenshots/conference-desktop-light.png';
import conferenceDark from '../../public/screenshots/conference-desktop-dark.png';
import mobileLight from '../../public/screenshots/division-mobile-light.png';
import mobileDark from '../../public/screenshots/division-mobile-dark.png';
import draftLight from '../../public/screenshots/draft-order-desktop-light.png';
import draftDark from '../../public/screenshots/draft-order-desktop-dark.png';
import '~/assets/styles/landing.css';

const { appUrl } = landing;
const metadata = {
  title: landing.title,
  description: landing.description,
};

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${landing.url}/#website`,
      name: landing.name,
      url: landing.url,
      inLanguage: 'en-US',
    },
    {
      '@type': 'WebPage',
      '@id': `${landing.url}/#webpage`,
      url: landing.url,
      name: landing.title,
      description: landing.description,
      inLanguage: 'en-US',
      isPartOf: { '@id': `${landing.url}/#website` },
      mainEntity: { '@id': `${landing.url}/#application` },
      primaryImageOfPage: { '@id': `${landing.url}/#preview` },
    },
    {
      '@type': 'WebApplication',
      '@id': `${landing.url}/#application`,
      name: landing.name,
      url: appUrl,
      mainEntityOfPage: { '@id': `${landing.url}/#webpage` },
      description: landing.description,
      applicationCategory: 'SportsApplication',
      operatingSystem: 'Any',
      screenshot: `${landing.url}/screenshots/division-desktop-light.png`,
      featureList: landing.features,
    },
    {
      '@type': 'ImageObject',
      '@id': `${landing.url}/#preview`,
      contentUrl: `${landing.url}/screenshots/division-desktop-light.png`,
      width: 1440,
      height: 913,
      caption: 'Division view in the NFL Live Standings app',
    },
  ],
};
---

<Layout metadata={metadata}>
  <Fragment slot="head">
    <link rel="describedby" href="/llms.txt" />
    <link rel="alternate" type="text/markdown" href="/index.md" title="NFL Live Standings overview" />
  </Fragment>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />
  <a class="skip-link" href="#top">Skip to content</a>
  <div class="site-shell">
    <header class="site-header">
      <nav class="nav container" aria-label="Main navigation">
        <a class="brand" href="#top" aria-label="NFL Live Standings home">
          <BrandMark class="brand-mark" />
          <span>NFL <span class="brand-live">Live</span> Standings</span>
        </a>
        <div class="nav-links">
          <button
            class="theme-toggle"
            type="button"
            data-aw-toggle-color-scheme
            aria-label="Toggle dark and light mode"
          >
            <svg
              class="sun-icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="4"></circle><path
                d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"
              ></path>
            </svg>
            <svg
              class="moon-icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              aria-hidden="true"
            >
              <path d="M20.2 15.4A8.5 8.5 0 0 1 8.6 3.8 8.5 8.5 0 1 0 20.2 15.4Z"></path>
            </svg>
          </button>
        </div>
      </nav>
    </header>

    <main id="top" tabindex="-1">
      <section class="hero">
        <div class="hero-grid container">
          <div>
            <div class="eyebrow"><span class="live-dot"></span> Live scores · Live standings</div>
            <h1>Real-time NFL standings <span>updated during every game.</span></h1>
            <p class="hero-copy">
              {landing.intro} Switch between
              <strong>Live</strong> and <strong>Final</strong> standings at any time.
            </p>
            <div class="actions">
              <a class="button button-primary" href={appUrl}>
                View live standings
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"
                  ><path d="m9 18 6-6-6-6"></path></svg
                >
              </a>
            </div>
          </div>

          <div class="product-stage" aria-label="NFL Live Standings app preview">
            <div class="browser">
              <div class="browser-bar"><i></i><i></i><i></i><span>STANDINGS.NFLLIVESTANDINGS.COM</span></div>
              <ThemeScreenshot
                lightSrc={divisionLight}
                darkSrc={divisionDark}
                alt="Division view in the NFL Live Standings app"
                sizes="(max-width: 640px) calc(100vw - 28px), (max-width: 900px) min(760px, calc(100vw - 40px)), (max-width: 1220px) calc(56vw - 57px), 626px"
                eager
              />
            </div>
            <div class="floating-live"><span class="live-dot"></span> Live mode</div>
          </div>
        </div>
      </section>

      <div class="trust-strip">
        <div class="trust-grid container">
          <div class="trust-item">
            <strong>Updates during games</strong><span>See each score change reflected in the standings.</span>
          </div>
          <div class="trust-item">
            <strong>Live and Final views</strong><span>Compare the live projection with completed-game records.</span>
          </div>
          <div class="trust-item">
            <strong>NFL tiebreaker procedures</strong><span>See the tiebreak behind a team's position.</span>
          </div>
        </div>
      </div>

      <section class="section" id="how-it-works">
        <div class="live-story container">
          <div>
            <p class="section-kicker">Live updates</p>
            <h2 class="section-title">See standings change while games are live.</h2>
            <p class="section-lede">
              Live mode treats each in-progress score as final and recalculates every affected position. Switch to Final
              mode to see standings based only on completed games.
            </p>
            <ul class="plain-list">
              <li><strong>Live or Final:</strong> change views with one switch.</li>
              <li><strong>Position movement:</strong> see how many places each team gained or lost.</li>
              <li><strong>Tiebreak details:</strong> open the reason behind a tied team's rank.</li>
            </ul>
            <p class="section-lede">
              Read the <a class="text-link" href={landing.rulesUrl}>official NFL tiebreaking procedures</a> for division
              and conference standings.
            </p>
          </div>
          <StandingsPreview />
        </div>
      </section>

      <section class="section features-section" id="standings">
        <div class="container">
          <div class="features-head">
            <div>
              <p class="section-kicker">Standings views</p>
              <h2 class="section-title">Division, conference and draft order.</h2>
            </div>
            <p class="section-lede">
              Move between all three views without leaving the page. Live changes use the same standings and tiebreaker
              rules in every view.
            </p>
          </div>
          <div class="feature-grid">
            <article class="feature-card">
              <span class="feature-number">01 / DIVISION</span><h3>Division standings</h3><p>
                Follow all eight NFL divisions. See each leader, win-loss record, division record, conference record,
                strength of victory and strength of schedule.
              </p>
            </article>
            <article class="feature-card">
              <span class="feature-number">02 / CONFERENCE</span><h3>Conference and playoffs</h3><p>
                See the AFC and NFC order, playoff cutoff and live position movement. Clinch markers show secured seeds,
                playoff places and eliminations.
              </p>
            </article>
            <article class="feature-card">
              <span class="feature-number">03 / DRAFT ORDER</span><h3>First-round draft order</h3><p>
                Track all 32 first-round picks and see which picks have been traded. Switch between current SOS and
                full-season SOS.
              </p>
            </article>
          </div>
        </div>
      </section>

      <section class="section" id="app">
        <div class="container">
          <div class="showcase-head">
            <p class="section-kicker">Desktop and mobile</p>
            <h2 class="section-title">Check the same standings on any screen.</h2>
            <p class="section-lede">
              Team, record and position data stay visible on mobile, with more tiebreaker detail available on desktop.
            </p>
          </div>
          <div class="screens">
            <div class="desktop-shot">
              <ThemeScreenshot
                lightSrc={conferenceLight}
                darkSrc={conferenceDark}
                alt="NFL conference standings on desktop with playoff positions and live movement"
                sizes="(max-width: 640px) calc(100vw - 64px), (max-width: 1220px) calc(100vw - 120px), 1100px"
              />
            </div>
            <div class="mobile-shot">
              <ThemeScreenshot
                lightSrc={mobileLight}
                darkSrc={mobileDark}
                alt="NFL division standings on mobile"
                sizes="(max-width: 640px) 30vw, (max-width: 1220px) 24vw, 270px"
              />
            </div>
          </div>

          <article class="draft-showcase">
            <div class="draft-copy">
              <p class="section-kicker">Draft order</p>
              <h2 class="section-title">See who owns each first-round pick.</h2>
              <p class="section-lede">
                The draft order updates with live results. Traded picks are assigned to their current owner, and the SOS
                control switches between games played and the full 17-game schedule.
              </p>
              <ul class="plain-list">
                <li><strong>Current SOS:</strong> strength of schedule from games already played.</li>
                <li><strong>Season SOS:</strong> strength of schedule across the full schedule.</li>
                <li><strong>Pick trades:</strong> see the current owner of each traded first-round pick.</li>
              </ul>
            </div>
            <div class="draft-shot">
              <ThemeScreenshot
                lightSrc={draftLight}
                darkSrc={draftDark}
                alt="Live NFL first-round draft order showing position movement and current SOS"
                sizes="(max-width: 640px) calc(100vw - 28px), (max-width: 900px) calc(100vw - 40px), (max-width: 1220px) calc(64vw - 67px), 714px"
              />
            </div>
          </article>
          <p class="preview-note">{landing.previewNote}</p>
        </div>
      </section>

      <section class="section features-section" id="questions" aria-labelledby="questions-title">
        <div class="container">
          <p class="section-kicker">How to read the standings</p>
          <h2 class="section-title" id="questions-title">Live NFL standings questions.</h2>
          <div class="faq-list">
            {
              landing.questions.map(({ question, answer }) => (
                <details>
                  <summary>{question}</summary>
                  <p>{answer}</p>
                </details>
              ))
            }
          </div>
        </div>
      </section>

      <section class="cta">
        <div class="cta-panel container">
          <div>
            <h2>Check the live NFL standings.</h2><p>Open the app to follow the standings during today's games.</p>
          </div>
          <a class="button button-primary" href={appUrl}
            >Open NFL Live Standings <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg
            ></a
          >
        </div>
      </section>
    </main>

    <footer class="footer container">
      <a class="brand" href="#top"
        ><BrandMark class="brand-mark" /><span>NFL <span class="brand-live">Live</span> Standings</span></a
      >
      <a class="text-link" href="#questions">How to read the standings</a>
    </footer>
  </div>
</Layout>
